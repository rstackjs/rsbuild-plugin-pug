{
  "name": "@rsbuild/plugin-pug",
  "version": "2.0.0",
  "repository": "https://github.com/rstackjs/rsbuild-plugin-pug",
  "homepage": "https://github.com/rstackjs/rsbuild-plugin-pug#readme",
  "bugs": {
    "url": "https://github.com/rstackjs/rsbuild-plugin-pug/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib",
    "dev": "rslib -w",
    "lint": "rslint && prettier -c .",
    "lint:write": "rslint --fix && prettier -w .",
    "prepare": "simple-git-hooks",
    "test": "rstest",
    "bump": "pnpx bumpp"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint:write"
  },
  "dependencies": {
    "@types/pug": "^2.0.10",
    "lodash": "^4.18.1",
    "pug": "^3.0.4",
    "reduce-configs": "^2.0.1"
  },
  "devDependencies": {
    "@rsbuild/core": "2.1.9",
    "@rsbuild/plugin-vue": "2.0.1",
    "@rslib/core": "^0.23.2",
    "@rslint/core": "^0.8.0",
    "@rstest/core": "^0.11.5",
    "@rstest/playwright": "^0.11.5",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.5",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2",
    "vue": "^3.5.40"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.18.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
