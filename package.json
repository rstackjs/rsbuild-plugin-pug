{
  "name": "@rsbuild/plugin-pug",
  "version": "1.3.4",
  "repository": "https://github.com/rstackjs/rsbuild-plugin-pug",
  "homepage": "https://github.com/rstackjs/rsbuild-plugin-pug#readme",
  "bugs": {
    "url": "https://github.com/rstackjs/rsbuild-plugin-pug/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib",
    "dev": "rslib -w",
    "lint": "rslint && prettier -c .",
    "lint:write": "rslint --fix && prettier -w .",
    "prepare": "simple-git-hooks",
    "test": "playwright test",
    "bump": "pnpx bumpp"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint:write"
  },
  "dependencies": {
    "@types/pug": "^2.0.10",
    "lodash": "^4.18.1",
    "pug": "^3.0.4",
    "reduce-configs": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@rsbuild/core": "2.0.15",
    "@rsbuild/plugin-vue": "1.2.9",
    "@rslib/core": "^0.23.0",
    "@rslint/core": "^0.6.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.3",
    "playwright": "^1.61.0",
    "prettier": "^3.8.4",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vue": "^3.5.38"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
